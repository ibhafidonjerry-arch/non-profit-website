:root {
  --dark-red:#5c1414;
  --dark-red-hover: #5c1414;
  --cream: #f5ece2;
  --line: rgba(245, 236, 226, 0.15);
}

* { box-sizing: border-box; }

body {
  margin: 0;
  font-family: 'Source Sans 3', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 16px;
  line-height: 1.6;
  background: ;
  color: #eee;
  min-height: 100vh;
}


.page {
  padding: 60px 40px;
  max-width: 700px;
}
.page h1 { font-family: Georgia, serif; font-weight: normal; letter-spacing: 0.5px; }
.page p { line-height: 1.7; color: #ccc; }

.menu-toggle {
  position: fixed;
  top: 20px;
  right: 50px;
  z-index: 10005;
  background: rgba(0,0,0,0.12);
  color: var(--cream);
  border: none;
  width: 52px;
  height: 44px;
  border-radius: 6px;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5px;
  transition: opacity 0.2s ease;
}
.menu-toggle:hover { opacity: 0.7; }

.menu-toggle span {
  display: block;
  width: 24px;
  height: 2px;
  background: var(--cream);
  border-radius: 2px;
  transition: transform 0.3s ease, opacity 0.3s ease;
}

/* Turn the three bars into an X when open */
.menu-toggle.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.menu-toggle.open span:nth-child(2) { opacity: 0; }
.menu-toggle.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

/* The dropdown panel itself, anchored to the right, collapsed by default */
.dropdown-nav {
  position: fixed;
  top: 0;
  right: 0;
  width: 260px;
  max-width: 80vw;
  background: var(--dark-red);
  overflow: hidden;
  max-height: 0;
  transition: max-height 0.5s cubic-bezier(0.65, 0, 0.35, 1);
  z-index: 1000;
  box-shadow: 0 4px 20px rgba(0,0,0,0.5);
}

.dropdown-nav.open {
  max-height: 500px; /* big enough to reveal all links */
}

.dropdown-nav ul {
  list-style: none;
  margin: 0;
  padding: 80px 0 20px 0;
}

.dropdown-nav a {
  display: block;
  padding: 16px 30px;
  color: var(--cream);
  text-decoration: none;
  font-size: 17px;
  letter-spacing: 0.5px;
  transition: color 0.2s ease, padding-left 0.2s ease;
}

.dropdown-nav a:hover {
  color: #ff4d4d;
  padding-left: 38px;
}
header {
  padding: 24px 40px 0;
  background:#4a0d0d;
  position: fixed;
  width: 100%;
}

.logo {
  display: flex;
  align-items: center;
  gap: 18px;
  width: fit-content;
}

.logo img {
  width: 60px;
  height: 60px;
  display: block;
  flex-shrink: 0;
}

.logo h1 {
  margin: 0;
  font-size: 25px;
  line-height: 1;
  color: var(--cream);
  white-space: nowrap
}
.logo h1{
    margin-left:10px;
}
